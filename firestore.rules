rules_version = '2';

// Senlings Firestore ルール（v1 最小形）
// デプロイは Console に手で貼る（CLI 設定は持たない）。
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── projects（工事台帳） ──────────────────────────────
    // read 全開放は仮の戸。届け先の絞り（audience / assignments）を起こすとき、
    // read をログイン必須＋絞り条件に締め直す。
    match /projects/{projectId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── users ────────────────────────────────────────────
    // 本人のみ read。write は admin のみ。
    // （最初の admin ドキュメントは Console から手で置く）
    match /users/{userId} {
      allow read:  if isSignedIn() && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // その他のコレクションは match を書かない = デフォルト拒否。

  }
}
