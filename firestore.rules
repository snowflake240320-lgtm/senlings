rules_version = '2';

// Senlings Firestore ルール（v1 最小形）
// デプロイは Console に手で貼る（CLI 設定は持たない）。
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── projects（工事台帳） ──────────────────────────────
    // read 全開放は仮の戸。届け先の絞り（audience / assignments）を起こすとき、
    // read をログイン必須＋絞り条件に締め直す。
    match /projects/{projectId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── users ────────────────────────────────────────────
    // 本人のみ read。write は admin のみ。
    // （最初の admin ドキュメントは Console から手で置く）
    match /users/{userId} {
      allow read:  if isSignedIn() && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // ── boxes(郵便受け。2026-10-26)──────────────────────
    // 同じスマホの中で、ブラウザからホーム画面の Senlings へ届けるための置き場。
    // 番号は鍵のハッシュ(誰にも当てられない)。中身(c)は封をしてあり、誰にも読めない。
    // 受け取った側が消す。受け取られなかったものは x(日限)で消える(Console の TTL ポリシー:items の x、boxes の x)。
    // 箱そのものには「家がある」の印(home)だけ。中身は置かない。
    match /boxes/{box} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['home', 'x'])
        && request.resource.data.home == true
        && request.resource.data.x is timestamp;
      allow delete: if false;

      match /items/{item} {
        allow read, delete: if true;
        allow create: if request.resource.data.keys().hasOnly(['c', 't', 'x'])
          && request.resource.data.c is string && request.resource.data.c.size() <= 8000
          && request.resource.data.t is int
          && request.resource.data.x is timestamp;
        allow update: if false;
      }
    }

    // その他のコレクションは match を書かない = デフォルト拒否。

  }
}
